{
  "name": "cooksona-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "nx build",
    "watch": "nx build --watch --configuration development",
    "test": "nx test",
    "lint": "nx run-many -t lint --all --parallel=3",
    "format": "prettier --write \"**/*.{ts,js,json,scss,css,html,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,scss,css,html,md}\"",
    "format:staged": "git diff --name-only --staged --relative | grep -E '\\.(ts|js|json|scss|css|html|md)$' | xargs --no-run-if-empty prettier --write",
    "a11y:test": "node tools/test-accessibility.js",
    "a11y:test:ci": "pa11y-ci",
    "a11y:audit": "axe http://localhost:4200 --save a11y-reports/axe-results.json --tags wcag2a,wcag2aa,wcag21a,wcag21aa"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.4",
    "@angular/common": "^20.1.4",
    "@angular/compiler": "^20.1.4",
    "@angular/core": "^20.1.4",
    "@angular/forms": "^20.1.4",
    "@angular/platform-browser": "^20.1.4",
    "@angular/platform-browser-dynamic": "^20.1.4",
    "@angular/router": "^20.1.4",
    "@nativescript/angular": "^20.0.0",
    "@nativescript/core": "~8.9.0",
    "abort-controller": "^3.0.0",
    "event-target-shim": "^6.0.2",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.4",
    "@angular-devkit/core": "^20.1.4",
    "@angular-devkit/schematics": "^20.1.4",
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.4",
    "@axe-core/cli": "^4.11.0",
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.8.0",
    "@nativescript/nx": "^21.0.0",
    "@nativescript/preview-cli": "1.0.14",
    "@nativescript/tailwind": "^2.1.0",
    "@nativescript/types": "~8.9.0",
    "@nativescript/webpack": "~5.0.0",
    "@ngtools/webpack": "^20.1.4",
    "@nx/angular": "21.5.2",
    "@nx/eslint": "21.5.2",
    "@nx/eslint-plugin": "21.5.2",
    "@nx/js": "21.5.2",
    "@nx/workspace": "21.5.2",
    "@schematics/angular": "^20.1.4",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/jasmine": "~5.1.0",
    "ajv": "~8.17.0",
    "axe-core": "^4.11.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "nx": "21.5.2",
    "pa11y": "^9.0.1",
    "prettier": "^3.6.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.40.0"
  },
  "nativescript-nx": {
    "framework": "angular"
  }
}
